---
import settings from '../data/settings.json';

// Generic icons with clear text labels, so each link reads well without brand logos.
const icons: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/>',
  play: '<rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>',
  people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14.8c1.8.8 3 2.5 3.5 5.2"/>',
  camera: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".8" fill="currentColor"/>',
  note: '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  at: '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>',
};

const links = [
  { label: 'YouTube', url: settings.youtube, icon: 'play' },
  { label: 'Facebook', url: settings.facebook, icon: 'people' },
  { label: 'Instagram', url: settings.instagram, icon: 'camera' },
  { label: 'TikTok', url: settings.tiktok, icon: 'note' },
  { label: 'X', url: settings.x, icon: 'at' },
  { label: 'Email', url: settings.email ? `mailto:${settings.email}` : '', icon: 'mail' },
].filter((l) => l.url);
---
{links.length > 0 && (
  <ul class="socials" role="list" style="list-style:none;margin:0;padding:0">
    {links.map((l) => (
      <li>
        <a class="social" href={l.url} rel={l.icon === 'mail' ? undefined : 'me noopener'} target={l.icon === 'mail' ? undefined : '_blank'}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[l.icon]} />
          {l.label}
        </a>
      </li>
    ))}
  </ul>
)}
