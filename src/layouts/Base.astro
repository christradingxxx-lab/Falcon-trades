---
import '../styles/global.css';
import settings from '../data/settings.json';
import Socials from '../components/Socials.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = settings.siteDescription, image } = Astro.props;
const pageTitle = title ? `${title} · ${settings.brand}` : `${settings.brand} · Trading Journal`;
const path = Astro.url.pathname;
const nav = [
  { href: '/journal/', label: 'Journal' },
  { href: '/playbooks/', label: 'Playbooks' },
  { href: '/research/', label: 'Research' },
  { href: '/tools/', label: 'Tools' },
  { href: '/videos/', label: 'Videos' },
  { href: '/about/', label: 'About' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).href} />}
    <meta name="theme-color" content="#1B231D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Main">
        <a href="/" class="brand">
          <span class="crest" aria-hidden="true">{settings.brand.charAt(0)}</span>
          <span class="brand-name">
            <strong>{settings.brand}</strong>
            {settings.established && <span>Est. {settings.established}</span>}
          </span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <div class="nav-links" id="nav-links">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="between" style="align-items:center">
          <a href="/" class="brand" aria-label={`${settings.brand} home`}>
            <span class="brand-name"><strong>{settings.brand}</strong></span>
          </a>
          <Socials />
        </div>
        <p class="disclaimer">{settings.disclaimer}</p>
        <p class="mono muted" style="margin:0">© {year} {settings.brand}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const links = document.getElementById('nav-links');
      btn?.addEventListener('click', () => {
        const open = links?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
