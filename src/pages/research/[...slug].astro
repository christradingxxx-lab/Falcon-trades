---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getResearch, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getResearch();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <article>
    <header class="narrow stack" style="padding:72px 24px 32px;gap:18px">
      <a href="/research/" class="link-arrow" style="min-height:auto">← Research</a>
      <div class="meta"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></div>
      <h1 class="h1" style="font-size:clamp(40px,6vw,64px)">{d.title}</h1>
      {d.summary && <p class="lead">{d.summary}</p>}
      {d.pdf && <div><a class="btn btn-gold" href={d.pdf} download>Download the paper (PDF)</a></div>}
      <div class="rule" aria-hidden="true"></div>
    </header>
    {d.cover && <div class="narrow" style="padding-bottom:32px"><img src={d.cover} alt="" style="border-radius:4px;border:1px solid var(--brown-line)" /></div>}
    <div class="narrow prose" style="padding-bottom:80px"><Content /></div>
  </article>
</Base>
