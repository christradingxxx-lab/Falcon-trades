---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="narrow stack center" style="padding:120px 24px;display:flex;flex-direction:column">
    <p class="eyebrow">404</p>
    <h1 class="h1">This page is <span class="it gold">off the chart.</span></h1>
    <p class="lead">It may have moved, or it may be a private journal entry.</p>
    <a class="btn btn-gold" href="/">Back to home</a>
  </section>
</Base>
