---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTools } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getTools();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.name} description={d.tagline} image={d.image}>
  <section class="container" style="padding:72px 24px 88px;display:flex;flex-wrap:wrap;gap:56px;align-items:flex-start">
    <div style="flex:999 1 520px;min-width:0" class="stack">
      <a href="/tools/" class="link-arrow" style="min-height:auto">← Tools</a>
      {d.platform && <p class="eyebrow">{d.platform}</p>}
      <h1 class="h1" style="font-size:clamp(40px,6vw,64px)">{d.name}</h1>
      {d.tagline && <p class="lead">{d.tagline}</p>}
      {d.image && <img src={d.image} alt="" style="border-radius:4px;border:1px solid var(--brown-line)" />}
      <div class="prose"><Content /></div>
    </div>
    <aside style="flex:1 1 300px;min-width:0;position:sticky;top:110px" class="card card--brown">
      {d.badge && <span class="tag" style="align-self:flex-start">{d.badge}</span>}
      <span style="font-family:var(--serif);font-size:40px;color:var(--gold);line-height:1.1">{d.price || 'Coming soon'}</span>
      {d.features.length > 0 && (
        <ul class="body-text" style="padding-left:18px;margin:0;display:flex;flex-direction:column;gap:6px">
          {d.features.map((f) => <li>{f}</li>)}
        </ul>
      )}
      {d.buyUrl ? (
        <a class="btn btn-gold" href={d.buyUrl} target="_blank" rel="noopener">Get it now</a>
      ) : (
        <span class="btn btn-gold" aria-disabled="true">Available soon</span>
      )}
      <p class="muted" style="margin:0;font-size:13px">For educational use. Trading involves substantial risk; past performance and backtests do not guarantee future results.</p>
    </aside>
  </section>
</Base>
